{
	"name": "@searchcast/browser",
	"version": "0.0.0",
	"description": "The real-browser runner of searchcast, as a library: turn a web search form into a JSON API by driving a real browser, with sites described by small JSON recipes.",
	"license": "AGPL-3.0-only",
	"keywords": [
		"browser",
		"chromium",
		"cdp",
		"search",
		"scraping",
		"json",
		"self-hosted"
	],
	"author": "wighawag",
	"homepage": "https://github.com/wighawag/searchcast/tree/main/packages/browser#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/searchcast.git",
		"directory": "packages/browser"
	},
	"bugs": {
		"url": "https://github.com/wighawag/searchcast/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./cli": {
			"types": "./dist/cli.d.ts",
			"default": "./dist/cli.js"
		}
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"dependencies": {
		"@searchcast/recipe": "workspace:^"
	},
	"devDependencies": {
		"@types/node": "^25.2.0",
		"prettier": "^3.8.4",
		"typescript": "^5.3.3",
		"vitest": "^4.0.18"
	},
	"scripts": {
		"build": "tsc",
		"test": "tsc && vitest run",
		"test:watch": "vitest",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	}
}
