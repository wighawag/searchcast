{
	"name": "@searchcast/recipe",
	"version": "0.1.0",
	"description": "The shared recipe schema, types and validator for searchcast (HTTP) and @searchcast/browser (real browser). One recipe file describes a site for both runners.",
	"license": "MIT",
	"keywords": [
		"search",
		"recipe",
		"schema",
		"scraping",
		"searchcast"
	],
	"author": "wighawag",
	"homepage": "https://github.com/wighawag/searchcast/tree/main/packages/recipe#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/searchcast.git",
		"directory": "packages/recipe"
	},
	"bugs": {
		"url": "https://github.com/wighawag/searchcast/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"default": "./dist/node.js"
		}
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"devDependencies": {
		"@types/node": "^25.2.0",
		"typescript": "^5.3.3",
		"vitest": "^4.0.18"
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc -p tsconfig.test.json",
		"test": "vitest run",
		"test:watch": "vitest"
	}
}
