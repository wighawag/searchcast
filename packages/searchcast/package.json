{
	"name": "searchcast",
	"version": "0.1.2",
	"description": "Keyless search engines over HTTP with a real browser's fingerprint (libcurl-impersonate), driven by recipes, with an engine chain that falls back to a real browser (@searchcast/browser).",
	"license": "AGPL-3.0-only",
	"keywords": [
		"search",
		"serp",
		"scraping",
		"recipe",
		"libcurl-impersonate",
		"fingerprint",
		"searchcast",
		"self-hosted"
	],
	"author": "wighawag",
	"homepage": "https://github.com/wighawag/searchcast/tree/main/packages/searchcast#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/searchcast.git",
		"directory": "packages/searchcast"
	},
	"bugs": {
		"url": "https://github.com/wighawag/searchcast/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"bin": {
		"searchcast": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./install": {
			"types": "./dist/install-api.d.ts",
			"default": "./dist/install-api.js"
		}
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@searchcast/recipe": "workspace:^",
		"css-select": "^7.0.0",
		"domhandler": "^6.0.1",
		"htmlparser2": "^12.0.0",
		"koffi": "^3.3.2"
	},
	"peerDependencies": {
		"@searchcast/browser": ">=0.1.0 <0.2.0"
	},
	"peerDependenciesMeta": {
		"@searchcast/browser": {
			"optional": true
		}
	},
	"devDependencies": {
		"@searchcast/browser": "workspace:^",
		"@types/node": "^25.2.0",
		"typescript": "^5.3.3",
		"vitest": "^4.0.18"
	},
	"scripts": {
		"build": "tsc",
		"prepack": "node ../../scripts/copy-publish-assets.mjs",
		"test": "vitest run",
		"test:watch": "vitest"
	}
}
